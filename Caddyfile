{$CADDY_SITE::80} {
	encode zstd gzip

	@internalPages path /setup /setup/* /docs /docs/* /redoc /redoc/* /openapi.json /openapi.json/*
	handle @internalPages {
		respond "Not found" 404
	}

	@backend path /api /api/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}

http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz "ok"
}
