# Docker Compose only. Copy to .env at the repository root.
# Use a private URL-safe PostgreSQL password (for example, openssl rand -hex 24).
# Keep these values consistent with the existing PostgreSQL volume after initialization.
POSTGRES_USER=shelfsync
POSTGRES_DB=shelfsync
POSTGRES_PASSWORD=

# Use a separate random secret of at least 32 bytes.
JWT_SECRET=

# Local Docker defaults. For a public deployment see the GoDaddy VPS guide.
CADDY_SITE=:80
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443
# Same-origin browsing needs no extra CORS origins.
CORS_ORIGINS=

# Optional cloud AI. Set an authorized model ID here to override the existing default.
AI_PROVIDER=claude
AI_FALLBACK_PROVIDER=groq
CLAUDE_API_KEY=
GROQ_API_KEY=
# CLAUDE_MODEL=
# GROQ_MODEL=

# Mock mode requires no Titan mailbox or credentials.
EMAIL_MODE=mock
ENABLE_REAL_EMAIL_DISPATCH=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
OWNER_EMAIL=

# Demo only. Keep disabled for live purchasing.
ENABLE_QUOTE_SIMULATION=false
ENABLE_BUSY_WEEK_SIMULATION=false
ENABLE_MOCK_PURCHASING=false
SEED_OWNER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# Public contact form only; purchasing dispatch has separate controls.
ENABLE_CONTACT_EMAIL=false
