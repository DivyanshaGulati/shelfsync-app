# Copy to backend/.env; keep secrets out of source control.
# Replace the password placeholder with your local database role password.
DATABASE_URL=postgresql+psycopg://shelfsync:your-local-database-password@127.0.0.1:5432/shelfsync
# Set a separate random JWT signing secret of at least 32 bytes.
JWT_SECRET=
# With no Claude key, use Groq locally. Add the Claude key on the backend host.
AI_PROVIDER=claude
AI_FALLBACK_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=15
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
OWNER_EMAIL=
QUOTE_COLLECTION_WINDOW_MINUTES=60
MAX_ACCEPTABLE_LEAD_TIME_DAYS=7
AUTO_ORDER_LIMIT=2000
# forecast tuning
SERVICE_LEVEL_Z=1.65
REVIEW_PERIOD_DAYS=7
# Comma-separated allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# configure strong local-only passwords before running seed.
# Existing user passwords are NEVER reset on reruns.
SEED_OWNER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# Resource-conscious Ollama defaults (switch model to a smaller installed model if needed)
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_MAX_OUTPUT_TOKENS=350
OLLAMA_KEEP_ALIVE=30s

# safe outgoing quotation email. Default: NO SMTP connection.
EMAIL_MODE=mock
ENABLE_REAL_EMAIL_DISPATCH=false
EMAIL_TIMEOUT_SECONDS=12
# For verified Titan mailbox, only after you intend to email real mapped vendors:
# EMAIL_HOST=smtp.titan.email
# EMAIL_PORT=587    # STARTTLS (or 465 for implicit SSL)
# EMAIL_USERNAME=orders@yourdomain.com
# EMAIL_PASSWORD=your-titan-app-password
# EMAIL_MODE=smtp
# ENABLE_REAL_EMAIL_DISPATCH=true

# explicit opt-in for demo-only fictional vendor replies.
# NEVER enable for live supplier workflows. Requires mock email mode.
ENABLE_QUOTE_SIMULATION=false

# controlled Owner-only Busy Week checkout demo.
# Requires mock-only email configuration. Default disabled.
ENABLE_BUSY_WEEK_SIMULATION=false

# Optional streamlined AI purchasing and simulated shipment lifecycle.
# Requires ENABLE_QUOTE_SIMULATION=true and mock-only email settings.
ENABLE_MOCK_PURCHASING=false

# Public contact form only; purchasing dispatch has separate controls.
ENABLE_CONTACT_EMAIL=false
